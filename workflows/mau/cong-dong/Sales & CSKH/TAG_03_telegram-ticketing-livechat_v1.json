    {
      "id": "c01200b7-8aa4-4d44-a9a9-a802179f3afc",
      "name": "Sticky Note2",
      "parameters": {
        "color": 5,
        "content": "## Support Side\n**This Part** is meant to forward replies that sent by support (members in the group)",
        "height": 473,
