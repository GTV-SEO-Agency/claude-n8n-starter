      "name": "Respond to Webhook",
      "parameters": {
        "options": {},
        "respondWith": "text",
        "responseBody": "={{ $json.query['hub.challenge'] }}"
      },
      "position": [
        1020,
        1040
      ],
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1
