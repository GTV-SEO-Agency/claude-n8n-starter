          "Label_5511644430826409825"
        ],
        "messageId": "={{ $('Receiving Invoices').item.json.id }}",
        "operation": "addLabels"
      },
      "position": [
        3320,
        400
      ],
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1
    },
