    {
      "alwaysOutputData": false,
      "executeOnce": false,
      "id": "01c5a934-9412-4ef9-81a8-c4aef19c8868",
      "name": "Switch",
      "parameters": {
        "options": {},
        "rules": {
          "values": [
            {
              "conditions": {
                "combinator": "and",
                "conditions": [
                  {
                    "leftValue": "={{ $json.from }}",
                    "operator": {
                      "operation": "contains",
                      "type": "string"
                    },
                    "rightValue": "you@example.com"
                  }
                ],
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 1
                }
              },
              "outputKey": "Multiple payment info in one mail",
              "renameOutput": true
            },
            {
              "conditions": {
                "combinator": "and",
                "conditions": [
                  {
                    "id": "47e3b84f-903c-4594-9297-785cfbea0316",
                    "leftValue": "={{ $json.from }}",
                    "operator": {
                      "operation": "regex",
                      "type": "string"
                    },
                    "rightValue": "\\b(?:noreply@messaging\\.hsbc\\.com\\.tw|hello@crypto\\.com|taipeifubon\\.com\\.tw)\\b"
                  }
                ],
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 1
                }
              },
              "outputKey": "One payment info in one mail",
              "renameOutput": true
            },
            {
              "conditions": {
