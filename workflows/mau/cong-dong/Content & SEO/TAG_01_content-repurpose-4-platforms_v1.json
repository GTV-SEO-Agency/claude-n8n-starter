            "LinkedIn Post": "={{ $json.platforms.linkedin.post }}",
            "Request ID": "={{ $json.requestId }}",
            "Title": "={{ $json.title }}",
            "Twitter Thread": "={{ JSON.stringify($json.platforms.twitter.thread) }}"
          }
        },
        "documentId": {
