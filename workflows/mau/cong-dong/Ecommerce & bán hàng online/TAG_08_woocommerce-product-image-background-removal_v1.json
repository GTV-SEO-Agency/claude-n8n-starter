      "typeVersion": 4.2
    },
    {
      "id": "383e0206-3cbe-4d4c-9e01-6ca857d3092b",
      "name": "Sticky Note2",
      "parameters": {
        "content": "## PRELIMINARY STEP\n- Clone [this Sheet](https://docs.google.com/spreadsheets/d/<YOUR_FILE_ID>/edit?usp=sharing) and set the columns ID and IMAGE\n- Get API_KEY from [BackgroundCut.co](https://backgroundcut.co)\n- Set Header Auth in \"Remove from Image URL\" node (Name: Authorization - Value: API_KEY)\n- Get WooCommerce API and set it in \"Update product\" node\n- Set YOUR_FTP_URL in the node \"New Image Url\"",
        "height": 180,
        "width": 720
      },
      "position": [
        -620,
        -180
      ],
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1
    },
    {
