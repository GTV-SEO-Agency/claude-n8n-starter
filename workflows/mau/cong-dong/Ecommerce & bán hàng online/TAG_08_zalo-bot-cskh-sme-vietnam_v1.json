      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1
    },
    {
      "id": "sticky-step2",
      "name": "Sticky Note2",
      "parameters": {
        "color": 7,
        "content": "## Identify customer\n\nExtracts sender ID, name, and message text from the Zalo payload, then looks up the customer in the Google Sheets CRM by sender ID.",
        "height": 240,
        "width": 360
      },
      "position": [
        -384,
