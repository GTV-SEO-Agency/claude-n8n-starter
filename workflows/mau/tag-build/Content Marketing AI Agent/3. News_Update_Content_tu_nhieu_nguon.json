    {
      "id": "083dded1-f4b2-4649-9214-377fa283d466",
      "name": "Create Newsletter HTML",
      "parameters": {
        "messages": {
          "values": [
            {
              "content": "=You are a professional at creating HTML email newsletters. You will receive a list of articles with: \n- descriptions & title\n- thumbnail image URLs\n- Source URLs.\n\nGenerate a well-formatted HTML email newsletter based on this content.\n\nHTML Template:\n<!DOCTYPE html>\n<html lang=\"vi\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <title>AI News Digest – 24h qua</title>\n  </head>\n\n  <body style=\"margin:0;padding:0;background:#f4f4f4;\">\n    <!-- wrapper -->\n    <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f4f4f4;\">\n      <tr>\n        <td align=\"center\">\n          <!-- email container -->\n          <table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#ffffff;font-family:Arial,Helvetica,sans-serif;\">\n            <!-- header -->\n            <tr>\n              <td style=\"padding:24px 32px;background:#20263a;color:#ffffff;text-align:center;\">\n                <h1 style=\"margin:0;font-size:24px;\">AI News Digest</h1>\n                <p style=\"margin:4px 0 0;font-size:14px;opacity:.8;\">\n                  Tổng hợp tin tức AI nổi bật 24&nbsp;giờ qua &bull; {{DD/MM/YYYY}}\n                </p>\n              </td>\n            </tr>\n\n            <!-- intro -->\n            <tr>\n              <td style=\"padding:24px 32px;font-size:15px;line-height:1.6;color:#333333;\">\n                Chào bạn,<br />\n                Dưới đây là những diễn biến quan trọng nhất về Trí tuệ nhân tạo trong ngày qua.\n              </td>\n            </tr>\n\n            <!-- BEGIN: news loop -->\n            <!-- ① Bosch CEO cảnh báo châu Âu về siết quy định AI -->\n            <tr>\n              <td style=\"padding:0 32px 24px;\">\n                <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n                  <tr>\n                    <td style=\"font-size:18px;font-weight:bold;padding-bottom:6px;\">\n                      <a href=\"https://www.reuters.com/technology/bosch-ceo-warns-europe-against-regulating-itself-death-ai-2025-06-25/\"\n                         style=\"color:#0066cc;text-decoration:none;\">Bosch CEO: Châu Âu có nguy cơ “tự bóp nghẹt” mình vì quy định AI</a>\n                    </td>\n                  </tr>\n                  <tr>\n                    <td style=\"font-size:14px;line-height:1.6;color:#555555;\">\n                      Stefan Hartung cho rằng bộ máy pháp lý rườm rà sẽ khiến EU tụt hậu trong cuộc đua AI; Bosch cam kết bơm thêm 2,5 tỷ € vào R&amp;D tới 2027. \n                    </td>\n                  </tr>\n                </table>\n              </td>\n            </tr>\n\n            <!-- ② Dự luật lưỡng đảng cấm AI Trung Quốc tại cơ quan liên bang -->\n            <tr>\n              <td style=\"padding:0 32px 24px;\">\n                <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n                  <tr>\n                    <td style=\"font-size:18px;font-weight:bold;padding-bottom:6px;\">\n                      <a href=\"https://apnews.com/article/<YOUR_ID>\"\n                         style=\"color:#0066cc;text-decoration:none;\">Hạ viện Mỹ đề xuất cấm hệ thống AI của Trung Quốc trong toàn bộ cơ quan liên bang</a>\n                    </td>\n                  </tr>\n                  <tr>\n                    <td style=\"font-size:14px;line-height:1.6;color:#555555;\">\n                      Dự luật nhấn mạnh rủi ro an ninh khi dùng AI từ “đối thủ” và khẳng định Mỹ đang bước vào “Chiến tranh Lạnh mới về AI”.\n                    </td>\n                  </tr>\n                </table>\n              </td>\n            </tr>\n\n            <!-- ③ Microsoft & OpenAI “căng” vì điều khoản AGI -->\n            <tr>\n              <td style=\"padding:0 32px 24px;\">\n                <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n                  <tr>\n                    <td style=\"font-size:18px;font-weight:bold;padding-bottom:6px;\">\n                      <a href=\"https://www.reuters.com/business/microsoft-openai-dueling-over-artificial-general-intelligence-information-2025-06-25/\"\n                         style=\"color:#0066cc;text-decoration:none;\">Microsoft muốn xoá điều khoản “AGI là hết duyên” với OpenAI</a>\n                    </td>\n                  </tr>\n                  <tr>\n                    <td style=\"font-size:14px;line-height:1.6;color:#555555;\">\n                      The Information tiết lộ: khi OpenAI đạt AGI, quyền truy cập của Microsoft sẽ kết thúc – và Redmond đang thương thảo quyết liệt để giữ lợi thế.\n                    </td>\n                  </tr>\n                </table>\n              </td>\n            </tr>\n\n            <!-- ④ Meta thắng bước đầu vụ kiện bản quyền -->\n            <tr>\n              <td style=\"padding:0 32px 24px;\">\n                <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n                  <tr>\n                    <td style=\"font-size:18px;font-weight:bold;padding-bottom:6px;\">\n                      <a href=\"https://www.reuters.com/sustainability/boards-policy-regulation/meta-fends-off-authors-us-copyright-lawsuit-over-ai-2025-06-25/\"\n                         style=\"color:#0066cc;text-decoration:none;\">Meta tạm “hạ” nhóm tác giả kiện vi phạm bản quyền huấn luyện AI</a>\n                    </td>\n                  </tr>\n                  <tr>\n                    <td style=\"font-size:14px;line-height:1.6;color:#555555;\">\n                      Thẩm phán quận San Francisco bác lập luận “thị trường bị tổn hại”, nhưng khẳng định vẫn có nhiều kịch bản sử dụng dữ liệu phạm luật.\n                    </td>\n                  </tr>\n                </table>\n              </td>\n            </tr>\n\n            <!-- ⑤ Tranh cãi “đóng băng” luật AI cấp bang đổi lấy ngân sách Internet -->\n            <tr>\n              <td style=\"padding:0 32px 40px;\">\n                <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n                  <tr>\n                    <td style=\"font-size:18px;font-weight:bold;padding-bottom:6px;\">\n                      <a href=\"https://www.reuters.com/legal/government/teamsters-president-urges-congress-scrap-ai-state-law-ban-2025-06-25/\"\n                         style=\"color:#0066cc;text-decoration:none;\">Đề xuất hoãn 10 năm quyền lập pháp AI của các tiểu bang Mỹ gặp phản ứng dữ dội</a>\n                    </td>\n                  </tr>\n                  <tr>\n                    <td style=\"font-size:14px;line-height:1.6;color:#555555;\">\n                      Liên đoàn Teamsters và nhiều Thượng nghị sĩ phản đối vì e ngại “món quà” cho Big Tech; phe ủng hộ nói cần một khung thống nhất để thúc đẩy đổi mới.\n                    </td>\n                  </tr>\n                </table>\n              </td>\n            </tr>\n            <!-- END: news loop -->\n\n            <!-- footer -->\n            <tr>\n              <td style=\"padding:24px 32px;font-size:12px;color:#999999;text-align:center;\">\n                Bạn nhận email này vì đã đăng ký nhận bản tin AI News Digest.<br />\n                <a href=\"theaigrowth.io\" style=\"color:#999;text-decoration:underline;\">Huỷ đăng ký</a>\n              </td>\n            </tr>\n          </table>\n          <!-- /email container -->\n        </td>\n      </tr>\n    </table>\n    <!-- /wrapper -->\n  </body>\n</html>\n\n\n\nInstructions:\n1. Replace the area between <!-- ARTICLES START --> and <!-- ARTICLES END --> with article divs\n2. Each article should be wrapped in <div class=\"article\"> tags\n3. Article title should be bold and clickable, linking to the source URL\n4. Include the thumbnail image for each article\n5. Add the article description\n6. Maintain clean HTML structure"
            },
            {
              "content": "={{ JSON.stringify($json.listforhtml) }}"
            }
          ]
