      "name": "Perplexity",
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "jsonBody": "={\n  \"model\": \"sonar-pro\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a deep researcher who have both marketing and research expertise. Your task is research the latest and the accurate infromation base on the user request./n You will prioriztie trustworthy website or orginal brand, for example, if you are research iphone product, you will look in apple website first. If you look for the review, choose the reddits or popular review website.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"{query}\"\n    }\n  ],\n\"search_domain_filter\": [\n        \"apple.com\",\n        \"reddit.com\"\n    ],\n  \"options\": {\n    \"temperature\": 1,\n    \"max_tokens\": 20000\n  }\n}",
        "method": "POST",
        "placeholderDefinitions": {
          "values": [
            {
              "description": "Performs search using Perplexity based on the provided query, which can include text and URLs. ",
              "name": "query",
              "type": "string"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "toolDescription": "Use this tool to Research the newest and accurate information based on user request.",
        "url": "https://api.perplexity.ai/chat/completions"
      },
