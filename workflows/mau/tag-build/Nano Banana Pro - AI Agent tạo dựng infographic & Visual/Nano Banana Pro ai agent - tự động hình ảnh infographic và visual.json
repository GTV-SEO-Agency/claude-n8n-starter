      "name": "Code in JavaScript",
      "parameters": {
        "jsCode": "// Lấy output prompt từ AI Agent\nconst rawPrompt = $input.first().json.output;\n\n// Clean prompt - xử lý các ký tự đặc biệt\nlet cleanedPrompt = rawPrompt\n  .replace(/\\\\n/g, '\\n')\n  .replace(/[\\u0000-\\u001F\\u007F-\\u009F\"]/g, ' ')\n  .trim();\n\n// Tạo payload cho API kie.ai\nconst payload = {\n  model: \"nano-banana-pro\",\n  input: {\n    prompt: cleanedPrompt,\n    aspect_ratio: \"16:9\",\n    resolution: \"2K\",\n    output_format: \"png\",\n    image_input: [\n      \"$('Google Sheets').first().json['Brand Logo']\"\n    ]\n  }\n};\n\nreturn {\n  json: payload\n};"
      },
