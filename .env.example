# Token MCP để Claude điều khiển n8n (bắt buộc ở bước nối n8n với Claude).
# Lấy ở n8n: Settings -> Instance-level MCP -> Connect -> tab API key -> copy Access token.
N8N_MCP_TOKEN=

# Chỉ cần khi gọi n8n REST API (tuỳ chọn).
# Tạo key: n8n -> Settings -> n8n API -> Create an API key.
# Chép file này thành .env rồi dán key vào sau dấu =. Không gửi file .env cho ai.
N8N_URL=http://localhost:5678
N8N_API_KEY=
